include install.py Install.command Install.bat
include README.zh-CN.md .env.example
recursive-include examples *.py
recursive-include docs *.md
recursive-include tools *.py
recursive-include tests *.py

# Git ignore rules do not control source distributions.
prune docs/local
prune .local
prune .agents
prune .codex
prune .claude
prune smoke
prune dist
prune build
global-exclude *.local.* *.log *.py[cod] .DS_Store ._* Thumbs.db Desktop.ini
global-exclude .env .env.* .linxsci-install.json *.swp *.swo *~
include .env.example
